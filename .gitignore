# Upstream ignores helper folders generally; this task explicitly restores only
# the root, reviewable HR runners and tests. Private/cache rules follow these
# exceptions so a nested secret or node_modules is NOT accidentally unignored.
scripts
tests
!/scripts/
!/scripts/**
!/tests/
!/tests/**

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example
database.sqlite
private.pem
public.pem
.next

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.certs
.certbot_www
.scripts
.tests
certs
certbot_www
# Local browser artifacts may contain test credentials/session data; never commit.
**/.auth/
playwright-report/
test-results/
