diff --git a/public/hr-push-sw.js b/public/hr-push-sw.js
new file mode 100644
index 0000000..7ca566d
--- /dev/null
+++ b/public/hr-push-sw.js
@@ -0,0 +1,38 @@
+// 來電通知的 Service Worker：只負責顯示推播通知與點擊後開啟網站。
+// 不攔截任何網路請求、不做快取，所以不會影響網站的載入或更新；
+// 註冊範圍刻意放在沒有頁面的 /hr-push/（推播不需要控制頁面），也不會和網站既有的 /sw.js 衝突。
+
+self.addEventListener('install', () => self.skipWaiting());
+self.addEventListener('activate', event => event.waitUntil(self.clients.claim()));
+
+self.addEventListener('push', event => {
+  let data = {};
+  try { data = event.data ? event.data.json() : {}; } catch { data = { body: event.data ? event.data.text() : '' }; }
+  const url = typeof data.url === 'string' && data.url.startsWith('/') && !data.url.startsWith('//') ? data.url : '/hr';
+  event.waitUntil(self.registration.showNotification(String(data.title || '📞'), {
+    body: String(data.body || ''),
+    tag: String(data.tag || 'hr-call'), // 同一個聊天室的來電只留一則，重撥時用 renotify 再提醒一次
+    renotify: true,
+    requireInteraction: true,
+    icon: '/icons/icon-192.png',
+    vibrate: [300, 150, 300, 150, 300],
+    timestamp: Number(data.ts) || Date.now(),
+    data: { url },
+  }));
+});
+
+self.addEventListener('notificationclick', event => {
+  event.notification.close();
+  const target = new URL((event.notification.data && event.notification.data.url) || '/hr', self.location.origin).href;
+  event.waitUntil((async () => {
+    const windows = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+    for (const client of windows) {
+      if (new URL(client.url).origin !== self.location.origin) continue;
+      await client.focus();
+      // 已經開著網站就切回去（網頁會重新連線並顯示還在響鈴的來電）；不在 /hr 頁面時帶過去
+      if (!new URL(client.url).pathname.startsWith('/hr') && 'navigate' in client) { try { await client.navigate(target); } catch { /* 不能導覽就維持原頁 */ } }
+      return;
+    }
+    await self.clients.openWindow(target);
+  })());
+});
diff --git a/src/app/api/hr/push/route.js b/src/app/api/hr/push/route.js
new file mode 100644
index 0000000..dca8989
--- /dev/null
+++ b/src/app/api/hr/push/route.js
@@ -0,0 +1,79 @@
+import { NextResponse } from 'next/server';
+import { auth } from '@/auth';
+import { ensureSchema } from '@/lib/hr-schema';
+import { getHrPrincipal } from '@/lib/hr-access';
+import { requestIsSameOrigin } from '@/lib/request-origin';
+import {
+  buildTestNotice, createRateLimiter, normalizeLanguage, normalizeSubscription,
+} from '@/lib/hr-call-notify-core';
+import {
+  deleteSubscription, pushConfigured, saveSubscription, sendWebPush, subscriptionsFor, removeSubscription,
+} from '@/lib/hr-call-notify-store';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+// 登記這台裝置的來電通知（Web Push 訂閱）。誰登記的就只通知誰：訂閱記在登入者的聊天室識別（與 /api/hr/chat 的 getReaderKey 相同，
+// tests/hr-call-integration.test.mjs 會檢查沒有改歧）。
+function getReaderKey(principal,session) {
+  if(principal.id)return `member:${principal.id}`;
+  return `admin:${session.user.email?.trim().toLowerCase()||session.user.lineUserId||'unknown'}`;
+}
+
+const testLimiter = createRateLimiter({ windowMs: 10000, max: 1 });
+
+async function identify(request, { write }) {
+  const session=await auth();
+  if(!session?.user)return { response: NextResponse.json({error:'Authentication required'},{status:401}) };
+  if(write&&!requestIsSameOrigin(request))return { response: NextResponse.json({error:'請從本站提交資料。',en:'Please submit from this site.'},{status:403}) };
+  await ensureSchema();
+  const principal=await getHrPrincipal(session);
+  if(!principal?.role)return { response: NextResponse.json({error:'HR membership required'},{status:403}) };
+  return { key: getReaderKey(principal,session) };
+}
+
+// 前端要知道：伺服器有沒有設定推播金鑰、公開金鑰是什麼（訂閱時需要）。
+export async function GET(request) {
+  const who=await identify(request,{write:false});
+  if(who.response)return who.response;
+  const enabled=pushConfigured();
+  return NextResponse.json({enabled,publicKey:enabled?process.env.HR_PUSH_VAPID_PUBLIC_KEY:''});
+}
+
+export async function POST(request) {
+  const who=await identify(request,{write:true});
+  if(who.response)return who.response;
+  try {
+    const body=await request.json();
+    const lang=normalizeLanguage(body.lang);
+    // 關閉通知不需要推播金鑰：金鑰被移除後，使用者仍然要能把自己的訂閱清掉
+    if(body.type==='unsubscribe'){
+      await deleteSubscription(who.key,body.endpoint);
+      return NextResponse.json({ok:true});
+    }
+    if(!pushConfigured())return NextResponse.json({error:'來電通知尚未啟用（伺服器缺少推播金鑰）。',en:'Call notifications are not enabled (the server has no push keys).'},{status:503});
+    if(body.type==='subscribe'){
+      const subscription=normalizeSubscription(body.subscription);
+      if(!subscription)return NextResponse.json({error:'通知訂閱資料不正確。',en:'Invalid notification subscription.'},{status:400});
+      await saveSubscription(who.key,subscription,{lang,userAgent:request.headers.get('user-agent')||''});
+      return NextResponse.json({ok:true});
+    }
+    if(body.type==='test'){
+      if(!testLimiter.allow(who.key))return NextResponse.json({error:'請稍等幾秒再測試。',en:'Please wait a few seconds before testing again.'},{status:429});
+      const subs=(await subscriptionsFor([who.key])).get(who.key)||[];
+      if(!subs.length)return NextResponse.json({error:'這台裝置還沒有開啟來電通知。',en:'Call notifications are not turned on for this device yet.'},{status:409});
+      let sent=0;
+      for(const sub of subs){
+        try{await sendWebPush(sub,JSON.stringify(buildTestNotice(normalizeLanguage(sub.lang,lang))),{TTL:60,urgency:'high'});sent+=1;}
+        catch(error){if(error?.statusCode===404||error?.statusCode===410)await removeSubscription(sub.endpoint);}
+      }
+      if(!sent)return NextResponse.json({error:'通知送不出去，請重新開啟來電通知。',en:'The notification could not be sent. Turn call notifications off and on again.'},{status:502});
+      return NextResponse.json({ok:true,sent});
+    }
+    return NextResponse.json({error:'不支援的操作。',en:'Unsupported action.'},{status:400});
+  } catch(error) {
+    if(error instanceof SyntaxError)return NextResponse.json({error:'資料格式不正確。',en:'Invalid request.'},{status:400});
+    console.error('hr_push_failed',error?.code||error?.name||'Error');
+    return NextResponse.json({error:'無法完成，請稍後再試。',en:'Unable to complete the request. Please try again later.'},{status:503});
+  }
+}
diff --git a/src/components/HrCallNotify.jsx b/src/components/HrCallNotify.jsx
new file mode 100644
index 0000000..412a56d
--- /dev/null
+++ b/src/components/HrCallNotify.jsx
@@ -0,0 +1,172 @@
+"use client";
+
+import { useCallback, useEffect, useState } from 'react';
+import { Bell, X } from 'lucide-react';
+import { useLanguage } from '@/context/LanguageContext';
+import { NOTIFY_COPY, detectNotifyEnvironment, urlBase64ToUint8Array } from '@/lib/hr-call-notify-client-core';
+import { copyFor, isSupportedLanguage } from '@/lib/language';
+import styles from './HrCallNotify.module.css';
+
+// 「來電通知」：讓這台裝置在網站沒開著（甚至鎖屏）時也能收到來電通知（Web Push）。
+// 伺服器端沒有設定推播金鑰時整個按鈕不顯示；沒開網頁通知但綁定 LINE 的人，離線來電會改收 LINE 通知（伺服器端處理）。
+const SW_URL = '/hr-push-sw.js';
+const SW_SCOPE = '/hr-push/'; // 推播不需要控制頁面，放在沒有頁面的範圍，不影響網站既有的 Service Worker
+
+async function callApi(method, body) {
+  const response = await fetch('/api/hr/push', { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined, cache: 'no-store' });
+  let data = {};
+  try { data = await response.json(); } catch { /* 沒有內容 */ }
+  return { ok: response.ok, status: response.status, data };
+}
+
+// 註冊並等到 Service Worker 啟用（訂閱推播需要已啟用的 worker）。
+async function registerWorker() {
+  const registration = await navigator.serviceWorker.register(SW_URL, { scope: SW_SCOPE });
+  if (registration.active) return registration;
+  const worker = registration.installing || registration.waiting;
+  if (!worker) throw new Error('service worker unavailable');
+  await new Promise((resolve, reject) => {
+    const check = () => { if (worker.state === 'activated') resolve(); else if (worker.state === 'redundant') reject(new Error('service worker redundant')); };
+    worker.addEventListener('statechange', check);
+    check();
+  });
+  return registration;
+}
+
+const sameKey = (buffer, bytes) => {
+  if (!buffer) return false;
+  const a = new Uint8Array(buffer);
+  return a.length === bytes.length && a.every((value, index) => value === bytes[index]);
+};
+
+export default function HrCallNotify() {
+  const { lang } = useLanguage();
+  const language = isSupportedLanguage(lang) ? lang : 'zh';
+  const t = copyFor(NOTIFY_COPY, language);
+  const [config, setConfig] = useState(null);
+  const [environment, setEnvironment] = useState(null);
+  const [subscribed, setSubscribed] = useState(false);
+  const [open, setOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState(null);
+
+  const detect = useCallback(() => {
+    const standalone = window.matchMedia?.('(display-mode: standalone)').matches || window.navigator.standalone === true;
+    setEnvironment(detectNotifyEnvironment({
+      userAgent: window.navigator.userAgent,
+      maxTouchPoints: window.navigator.maxTouchPoints,
+      standalone,
+      isSecureContext: window.isSecureContext,
+      hasServiceWorker: 'serviceWorker' in navigator,
+      hasPushManager: 'PushManager' in window,
+      hasNotification: 'Notification' in window,
+      permission: 'Notification' in window ? Notification.permission : 'default',
+    }));
+  }, []);
+
+  useEffect(() => { detect(); }, [detect]);
+
+  useEffect(() => {
+    let active = true;
+    callApi('GET').then(result => { if (active && result.ok) setConfig(result.data); }).catch(() => {});
+    return () => { active = false; };
+  }, []);
+
+  // 已經開啟過的裝置：確認訂閱還在，並把目前的語言與訂閱同步給伺服器（瀏覽器換了訂閱網址也會在這裡補登記）
+  useEffect(() => {
+    if (!config?.enabled || environment !== 'available' || Notification.permission !== 'granted') return undefined;
+    let active = true;
+    (async () => {
+      try {
+        const registration = await registerWorker();
+        const existing = await registration.pushManager.getSubscription();
+        if (!active) return;
+        setSubscribed(!!existing);
+        if (existing) await callApi('POST', { type: 'subscribe', subscription: existing.toJSON(), lang: language });
+      } catch { /* 沒辦法確認時維持關閉狀態，使用者可以手動重新開啟 */ }
+    })();
+    return () => { active = false; };
+  }, [config, environment, language]);
+
+  useEffect(() => {
+    if (!open) return undefined;
+    const onKey = event => { if (event.key === 'Escape') setOpen(false); };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [open]);
+
+  if (!environment || (config && !config.enabled)) return null;
+
+  const fail = (text, data) => setMessage({ error: true, text: (language === 'zh' ? data?.error : data?.en) || text });
+
+  const enable = async () => {
+    setBusy(true); setMessage(null);
+    try {
+      const permission = await Notification.requestPermission();
+      detect();
+      if (permission !== 'granted') { fail(t.errors.permission); return; }
+      const key = urlBase64ToUint8Array(config.publicKey);
+      const registration = await registerWorker();
+      let subscription = await registration.pushManager.getSubscription();
+      // 推播金鑰換過時，舊訂閱不能再用，要重新訂閱
+      if (subscription && !sameKey(subscription.options?.applicationServerKey, key)) { await subscription.unsubscribe(); subscription = null; }
+      if (!subscription) subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: key });
+      const result = await callApi('POST', { type: 'subscribe', subscription: subscription.toJSON(), lang: language });
+      if (!result.ok) { await subscription.unsubscribe().catch(() => {}); fail(t.errors.server, result.data); return; }
+      setSubscribed(true);
+    } catch { fail(t.errors.subscribe); } finally { setBusy(false); }
+  };
+
+  const disable = async () => {
+    setBusy(true); setMessage(null);
+    try {
+      const registration = await registerWorker();
+      const subscription = await registration.pushManager.getSubscription();
+      if (subscription) {
+        await callApi('POST', { type: 'unsubscribe', endpoint: subscription.endpoint });
+        await subscription.unsubscribe();
+      }
+      setSubscribed(false);
+    } catch { fail(t.errors.server); } finally { setBusy(false); }
+  };
+
+  const sendTest = async () => {
+    setBusy(true); setMessage(null);
+    try {
+      const result = await callApi('POST', { type: 'test', lang: language });
+      if (result.ok) setMessage({ error: false, text: t.testSent }); else fail(t.errors.test, result.data);
+    } catch { fail(t.errors.test); } finally { setBusy(false); }
+  };
+
+  const guide = environment === 'ios-install' ? t.iosInstall : environment === 'denied' ? t.denied : null;
+  const plain = { insecure: t.insecure, inapp: t.inapp, unsupported: t.unsupported }[environment];
+
+  return <>
+    <button type="button" className={styles.button} onClick={() => { setMessage(null); setOpen(true); }} aria-label={t.button} title={t.button}>
+      <Bell size={16} aria-hidden="true" /><span className={styles.label}>{t.button}</span>
+      {subscribed && <i className={styles.dot} aria-hidden="true" />}
+    </button>
+    {open && <div className={styles.overlay} role="presentation" onClick={() => setOpen(false)}>
+      <div className={styles.dialog} role="dialog" aria-modal="true" aria-labelledby="hr-call-notify-title" onClick={event => event.stopPropagation()}>
+        <div className={styles.head}>
+          <h2 id="hr-call-notify-title">{guide ? guide.title : t.title}</h2>
+          <button type="button" className={styles.close} aria-label={t.close} onClick={() => setOpen(false)}><X size={18} aria-hidden="true" /></button>
+        </div>
+        {message && <p className={`${styles.message} ${message.error ? styles.isError : ''}`} role="status">{message.text}</p>}
+        {plain && <p className={styles.text}>{plain}</p>}
+        {guide && <><ol className={styles.steps}>{guide.steps.map(step => <li key={step}>{step}</li>)}</ol>{guide.note && <p className={styles.note}>{guide.note}</p>}</>}
+        {environment === 'available' && <>
+          <p className={styles.text}>{t.intro}</p>
+          {subscribed && <p className={styles.status}>{t.on}</p>}
+          <div className={styles.actions}>
+            {subscribed
+              ? <><button type="button" className={styles.primary} disabled={busy} onClick={sendTest}>{busy ? t.working : t.test}</button>
+                <button type="button" className={styles.secondary} disabled={busy} onClick={disable}>{t.disable}</button></>
+              : <button type="button" className={styles.primary} disabled={busy || !config} onClick={enable}>{busy ? t.working : t.enable}</button>}
+          </div>
+        </>}
+        <p className={styles.note}>{t.lineNote}</p>
+      </div>
+    </div>}
+  </>;
+}
