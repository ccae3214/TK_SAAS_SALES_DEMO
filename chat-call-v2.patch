+
+export const MAX_PARTICIPANTS = 6; // 多人通話是每個人彼此直連（mesh），超過約 4～6 人手機會吃不消
+export const RING_MS = 45000;
+const MAX_CONNECTIONS_PER_KEY = 6;
+const MAX_CONNECTIONS = 500;
+const MAX_MESSAGE_BYTES = 64 * 1024;
