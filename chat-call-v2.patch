+      case 'ping': conn.send({ t: 'pong' }); break;
+      case 'start': case 'join': this.enter(conn, message); break;
+      case 'signal': this.relay(conn, message); break;
+      case 'decline': this.decline(conn, message); break;
+      case 'leave': this.leave(conn); break;
+      default: break;
+    }
+  }
