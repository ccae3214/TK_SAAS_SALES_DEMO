+    if (set?.delete(conn)) this.connectionCount -= 1;
+    if (set && !set.size) this.byKey.delete(conn.key);
+  }
+
+  isParticipantKey(call, key) {
+    for (const participant of call.participants.values()) if (participant.key === key) return true;
+    return false;
+  }
+
