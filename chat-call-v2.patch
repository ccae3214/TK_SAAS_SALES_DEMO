@@ -0,0 +1,262 @@
+import crypto from 'node:crypto';
+import { verifyTicket } from './hr-call-ticket.js';
+
+// 通話信令：只轉送「誰要通話、誰加入、WebRTC 的連線資訊」，聲音與影像不經過這裡（瀏覽器之間直連，必要時走 TURN）。
