     {activeWorkspaceTab==='matching'&&data.role==='agency'&&<section className="hr-member-card"><h2>需求追蹤與歷史</h2><p>進行中需求依目前分工處理；已額滿或取消只保留紀錄。</p>{data.jobOrders.filter(order=>!orderJourney(order,data.orderAgencies,data.orderRoutes,data.orderCandidates).actionable).map(order=><article className="worker-case" key={order.id}><h3>需求 #{order.id} · {order.job_type} · {order.status==='cancelled'?'已取消':'已額滿'}</h3><OrderJourney order={order} data={data}/><HrNextSteps kind="order" order={order} data={data} agencyType={data.role==='agency'?data.agencyType:null}/><HrRecommendationHistory candidates={orderJourney(order,data.orderAgencies,data.orderRoutes,data.orderCandidates).candidates} readOnly/></article>)}</section>}
