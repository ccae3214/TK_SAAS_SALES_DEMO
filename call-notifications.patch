+  client.ws = {}; client.wsReady = true; client.send = message => sent.push(message);
+  client.env = { document: { visibilityState: 'visible' } };
+  client.reportVisibility(true);
+  assert.deepEqual(sent, []);
+  client.env = { document: { visibilityState: 'hidden' } };
+  client.reportVisibility(true);
+  client.env = { document: { visibilityState: 'visible' } };
+  client.reportVisibility();
+  assert.deepEqual(sent, [{ t: 'vis', v: false }, { t: 'vis', v: true }]);
+});
