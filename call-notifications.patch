+++ b/tests/hr-call-notify.test.mjs
@@ -0,0 +1,198 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import { CallHub } from '../src/lib/hr-call-signaling.js';
+import { signTicket } from '../src/lib/hr-call-ticket.js';
+import { createCallNotifier } from '../src/lib/hr-call-notify.js';
+import { PUSH_COPY, buildLineCallText, buildPushPayload, isAllowedPushEndpoint, normalizeSubscription, pushConfig } from '../src/lib/hr-push-core.js';
+
+const read = path => readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+const SECRET = 'test-secret';
+const ticket = (key, roomId, invitees, ct = '案件 A') => signTicket({ k: key, r: roomId, invitees, ct }, SECRET, 60);
+let nextId = 0;
+const conn = (key, name = key, extra = {}) => ({ id: `c${++nextId}`, key, name, sent: [], send(message) { this.sent.push(message); }, ...extra });
+
+function setup(options = {}) {
+  const rings = []; const stops = []; const timers = [];
+  const hub = new CallHub({
+    secret: SECRET, setTimer: fn => { timers.push(fn); return timers.length; }, clearTimer: () => {},
+    onRing: info => rings.push(info), onStop: info => stops.push(info), ...options,
+  });
+  return { hub, rings, stops, timers };
+}
+
+test('沒連線或不在前景的受邀者會被通知，開著網頁的不會', () => {
+  const { hub, rings } = setup();
+  const online = conn('member:2'); const hidden = conn('member:3'); const caller = conn('member:1', '王小明');
+  for (const item of [online, hidden, caller]) hub.addConnection(item);
+  hub.handle(hidden, { t: 'vis', v: false });
+  hub.handle(caller, { t: 'start', ticket: ticket('member:1', 7, ['member:2', 'member:3', 'member:4']), video: true });
+  assert.equal(rings.length, 1);
+  assert.deepEqual(rings[0].keys.sort(), ['member:3', 'member:4']);
+  assert.equal(rings[0].from, '王小明');
+  assert.equal(rings[0].video, true);
+  assert.ok(online.sent.some(message => message.t === 'incoming'));
+  hub.handle(hidden, { t: 'vis', v: true });
+  assert.equal(hub.isReachable('member:3'), true);
+});
+
+test('全部都在線時不送任何通知', () => {
+  const { hub, rings } = setup();
+  const online = conn('member:2'); const caller = conn('member:1');
+  hub.addConnection(online); hub.addConnection(caller);
+  hub.handle(caller, { t: 'start', ticket: ticket('member:1', 7, ['member:2']) });
+  assert.equal(rings.length, 0);
+});
+
+test('沒人接聽時改成未接來電；有人接聽就收掉通知', () => {
+  const missed = setup();
+  const caller = conn('member:1'); missed.hub.addConnection(caller);
+  missed.hub.handle(caller, { t: 'start', ticket: ticket('member:1', 7, ['member:4']) });
+  missed.timers[0]();
+  assert.equal(missed.stops.length, 1);
+  assert.equal(missed.stops[0].reason, 'no-answer');
+  assert.deepEqual(missed.stops[0].keys, ['member:4']);
+
+  const answered = setup();
+  const a = conn('member:1'); const b = conn('member:4');
+  answered.hub.addConnection(a); answered.hub.addConnection(b);
+  answered.hub.handle(b, { t: 'vis', v: false });
+  answered.hub.handle(a, { t: 'start', ticket: ticket('member:1', 8, ['member:4', 'member:5']) });
+  assert.deepEqual(answered.rings[0].keys.sort(), ['member:4', 'member:5']);
+  answered.hub.handle(b, { t: 'vis', v: true });
+  answered.hub.handle(b, { t: 'join', ticket: ticket('member:4', 8, []) });
+  assert.equal(answered.stops.length, 1);
+  assert.equal(answered.stops[0].reason, 'answered');
+  assert.deepEqual(answered.stops[0].keys, ['member:5']); // 已經接聽的人不用收掉
+  answered.hub.handle(a, { t: 'leave' });
+  answered.hub.handle(b, { t: 'leave' });
+  assert.equal(answered.stops.length, 1);
+});
+
+test('通知函式出錯或丟出例外，不影響通話', () => {
+  const { hub } = setup({ onRing: () => { throw new Error('boom'); }, onStop: () => Promise.reject(new Error('boom')) });
+  const caller = conn('member:1'); hub.addConnection(caller);
+  hub.handle(caller, { t: 'start', ticket: ticket('member:1', 7, ['member:4']) });
+  hub.handle(caller, { t: 'leave' });
+  assert.equal(caller.sent.some(message => message.t === 'joined'), true);
+});
+
+const VAPID = { HR_PUSH_VAPID_PUBLIC_KEY: 'B'.repeat(87), HR_PUSH_VAPID_PRIVATE_KEY: 'k'.repeat(43), HR_ADMIN_EMAILS: 'boss@example.com', APP_ORIGIN: 'https://hr.example.com' };
+const fakeStore = rows => { const removed = []; return { removed, forKeys: async keys => rows.filter(row => keys.includes(row.participant_key)), removeEndpoint: async endpoint => { removed.push(endpoint); } }; };
+const row = (key, endpoint, language = 'zh') => ({ participant_key: key, endpoint, p256dh: 'p', auth: 'a', language });
+
+test('推播依會員語言送出，失效的訂閱會被刪掉', async () => {
+  const sent = [];
+  const store = fakeStore([row('member:3', 'https://fcm.googleapis.com/a', 'en'), row('member:4', 'https://fcm.googleapis.com/b', 'zh'), row('member:5', 'https://fcm.googleapis.com/gone', 'zh')]);
+  const notifier = createCallNotifier({
+    store, query: async () => [], env: VAPID, log: { warn() {} },
+    sendPush: async (subscription, body, options) => { if (subscription.endpoint.endsWith('gone')) throw Object.assign(new Error('gone'), { statusCode: 410 }); sent.push({ endpoint: subscription.endpoint, body: JSON.parse(body), options }); },
+  });
+  const result = await notifier.ring({ roomId: 7, from: '王小明', video: false, keys: ['member:3', 'member:4', 'member:5'] });
+  assert.equal(result.push, 2);
+  assert.match(sent.find(item => item.endpoint.endsWith('/a')).body.title, /is calling you/);
+  assert.match(sent.find(item => item.endpoint.endsWith('/b')).body.title, /正在撥打語音通話給你/);
+  assert.equal(sent[0].options.urgency, 'high');
+  assert.deepEqual(store.removed, ['https://fcm.googleapis.com/gone']);
+  const stop = await notifier.stop({ roomId: 7, reason: 'no-answer', from: '王小明', keys: ['member:4'] });
+  assert.equal(stop, 1);
+  assert.equal(sent.at(-1).body.type, 'call-missed');
+  assert.equal(await notifier.stop({ roomId: 7, reason: 'ended', keys: [] }), 0);
+});
+
+test('LINE 只傳給有綁定的會員，同一場通話兩分鐘內不重複傳', async () => {
+  const requests = []; let clock = 1_000_000;
+  const query = async (sql, params) => {
+    if (sql.includes('hr_line_member_settings')) return [{ preferred_language: 'en' }];
+    if (sql.includes('WHERE id=$1')) return params[0] === 3 ? [{ line_user_id: 'U-three' }] : [];
+    if (sql.includes('lower(email)')) return params[0] === 'boss@example.com' ? [{ line_user_id: 'U-boss' }] : [];
+    return [];
+  };
+  const notifier = createCallNotifier({
+    store: fakeStore([]), query, env: { ...VAPID, LINE_MESSAGING_CHANNEL_ACCESS_TOKEN: 'token' }, now: () => clock, log: { warn() {} },
+    fetchImpl: async (url, init) => { requests.push({ url, init, body: JSON.parse(init.body) }); return { ok: true, status: 200 }; },
+  });
+  const keys = ['member:3', 'member:4', 'admin:boss@example.com', 'bogus'];
+  const first = await notifier.ring({ roomId: 7, from: 'Ana', video: true, keys });
+  assert.equal(first.line, 2);
+  assert.deepEqual(requests.map(item => item.body.to).sort(), ['U-boss', 'U-three']);
+  assert.equal(requests[0].url, 'https://api.line.me/v2/bot/message/push');
+  assert.equal(requests[0].init.headers.Authorization, 'Bearer token');
+  assert.match(requests[0].body.messages[0].text, /Ana is video calling you/);
+  assert.match(requests[0].body.messages[0].text, /https:\/\/hr\.example\.com\//);
+  assert.equal((await notifier.ring({ roomId: 7, from: 'Ana', keys })).line, 0);
+  clock += 3 * 60 * 1000;
+  assert.equal((await notifier.ring({ roomId: 7, from: 'Ana', keys })).line, 2);
+  assert.equal((await notifier.ring({ roomId: 8, from: 'Ana', keys: ['member:3'] })).line, 1);
+});
+
+test('沒有設定金鑰或關閉 LINE 時不送', async () => {
+  const requests = [];
+  const notifier = createCallNotifier({
+    store: fakeStore([row('member:3', 'https://fcm.googleapis.com/a')]), query: async () => [{ line_user_id: 'U' }],
+    env: { LINE_MESSAGING_CHANNEL_ACCESS_TOKEN: 'token', HR_CALL_LINE_NOTIFY: '0' }, fetchImpl: async () => { requests.push(1); return { ok: true }; },
+  });
+  assert.deepEqual(await notifier.ring({ roomId: 7, from: 'A', keys: ['member:3'] }), { push: 0, line: 0 });
+  assert.equal(requests.length, 0);
+  assert.equal(pushConfig({}), null);
+  assert.equal(pushConfig(VAPID).subject, 'mailto:boss@example.com');
+});
+
+test('訂閱網址只接受主流推播服務，欄位要完整', () => {
+  for (const ok of ['https://fcm.googleapis.com/fcm/send/abc', 'https://updates.push.services.mozilla.com/wpush/v2/abc', 'https://web.push.apple.com/abc', 'https://wns2-par02p.notify.windows.com/w/?token=x']) assert.equal(isAllowedPushEndpoint(ok), true, ok);
+  for (const bad of ['http://fcm.googleapis.com/a', 'https://evil.example.com/a', 'https://fcm.googleapis.com.evil.com/a', 'https://user:pw@fcm.googleapis.com/a', 'https://fcm.googleapis.com:8443/a', 'https://127.0.0.1/a', 'not a url', '']) assert.equal(isAllowedPushEndpoint(bad), false, bad);
+  const good = { endpoint: 'https://fcm.googleapis.com/a', keys: { p256dh: 'B'.repeat(87), auth: 'a'.repeat(22) } };
+  assert.deepEqual(normalizeSubscription(good), { endpoint: good.endpoint, p256dh: good.keys.p256dh, auth: good.keys.auth });
+  assert.equal(normalizeSubscription({ ...good, keys: { p256dh: 'x', auth: good.keys.auth } }), null);
+  assert.equal(normalizeSubscription({ endpoint: 'https://evil.example.com/a', keys: good.keys }), null);
+  assert.equal(normalizeSubscription(null), null);
+});
+
+test('通知文字有中英文（LINE 另有他加祿語），且不含換行注入', () => {
+  assert.match(buildPushPayload('start', { language: 'zh', from: '王小明', roomId: 3 }).title, /王小明/);
+  assert.match(buildPushPayload('start', { language: 'en', from: 'Ana', video: true, roomId: 3 }).title, /video calling/);
+  assert.equal(buildPushPayload('stop', { roomId: 3 }).type, 'call-stop');
+  assert.equal(buildPushPayload('missed', { language: 'en', from: 'Ana' }).title, 'Missed call: Ana');
+  assert.doesNotMatch(buildPushPayload('start', { from: 'a\nb\r\nc' }).title, /[\r\n]/);
+  assert.match(buildLineCallText({ language: 'tl', from: 'Ana', url: 'https://x/' }), /Tumatawag si Ana/);
+  assert.deepEqual(Object.keys(PUSH_COPY.en), Object.keys(PUSH_COPY.zh));
+  assert.deepEqual(Object.keys(PUSH_COPY.tl), Object.keys(PUSH_COPY.zh));
+  assert.doesNotMatch(JSON.stringify(PUSH_COPY.en), /[\u4e00-\u9fff]/);
+  assert.doesNotMatch(JSON.stringify(PUSH_COPY.tl), /[\u4e00-\u9fff]/);
+});
