diff --git a/src/app/api/hr/push/route.js b/src/app/api/hr/push/route.js
new file mode 100644
index 0000000..dbf7fec
--- /dev/null
+++ b/src/app/api/hr/push/route.js
@@ -0,0 +1,74 @@
+import { NextResponse } from 'next/server';
+import { auth } from '@/auth';
+import { ensureSchema } from '@/lib/hr-schema';
+import { getHrPrincipal } from '@/lib/hr-access';
+import { requestIsSameOrigin } from '@/lib/request-origin';
+import { normalizePushLanguage, normalizeSubscription, pushConfig } from '@/lib/hr-push-core';
+import { pushStore } from '@/lib/hr-push-store';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+// 來電推播的訂閱登記。使用者識別與通話相同（member:編號 或 admin:email），所以只能登記／取消自己的裝置。
+// 訂閱網址只接受主流瀏覽器的推播服務（見 hr-push-core.js），避免被拿來讓伺服器對任意網址發出請求。
+function participantKey(principal, session) {
+  if (principal.id) return `member:${principal.id}`;
+  return `admin:${session.user.email?.trim().toLowerCase() || session.user.lineUserId || 'unknown'}`;
+}
+
+async function identify() {
+  const session = await auth();
+  if (!session?.user) return { response: NextResponse.json({ error: 'Authentication required' }, { status: 401 }) };
+  await ensureSchema();
+  const principal = await getHrPrincipal(session);
+  if (!principal?.role) return { response: NextResponse.json({ error: 'HR membership required', en: 'HR membership required' }, { status: 403 }) };
+  return { key: participantKey(principal, session) };
+}
+
+export async function GET() {
+  try {
+    const who = await identify();
+    if (who.response) return who.response;
+    const config = pushConfig(process.env);
+    if (!config) return NextResponse.json({ enabled: false });
+    return NextResponse.json({ enabled: true, publicKey: config.publicKey, subscribed: await pushStore.has(who.key) });
+  } catch (error) {
+    console.error('hr_push_status_failed', error?.code || error?.name || 'Error');
+    return NextResponse.json({ error: '無法讀取通知設定。', en: 'Unable to read notification settings.' }, { status: 503 });
+  }
+}
+
+export async function POST(request) {
+  if (!requestIsSameOrigin(request)) return NextResponse.json({ error: '請從本站提交資料。', en: 'Please submit from this site.' }, { status: 403 });
+  try {
+    const who = await identify();
+    if (who.response) return who.response;
+    if (!pushConfig(process.env)) return NextResponse.json({ error: '伺服器尚未設定來電通知。', en: 'Call alerts are not configured on the server.' }, { status: 503 });
+    const body = await request.json();
+    const subscription = normalizeSubscription(body?.subscription);
+    if (!subscription) return NextResponse.json({ error: '通知資料不正確。', en: 'Invalid notification data.' }, { status: 400 });
+    await pushStore.save(who.key, subscription, normalizePushLanguage(body.language), request.headers.get('user-agent') || '');
+    return NextResponse.json({ ok: true });
+  } catch (error) {
+    if (error instanceof SyntaxError) return NextResponse.json({ error: '資料格式不正確。', en: 'Invalid request.' }, { status: 400 });
+    console.error('hr_push_save_failed', error?.code || error?.name || 'Error');
+    return NextResponse.json({ error: '無法儲存通知設定。', en: 'Unable to save notification settings.' }, { status: 503 });
+  }
+}
+
+export async function DELETE(request) {
+  if (!requestIsSameOrigin(request)) return NextResponse.json({ error: '請從本站提交資料。', en: 'Please submit from this site.' }, { status: 403 });
+  try {
+    const who = await identify();
+    if (who.response) return who.response;
+    const body = await request.json();
+    const endpoint = String(body?.endpoint || '');
+    if (!endpoint || endpoint.length > 2048) return NextResponse.json({ error: '通知資料不正確。', en: 'Invalid notification data.' }, { status: 400 });
+    await pushStore.remove(who.key, endpoint);
+    return NextResponse.json({ ok: true });
+  } catch (error) {
+    if (error instanceof SyntaxError) return NextResponse.json({ error: '資料格式不正確。', en: 'Invalid request.' }, { status: 400 });
+    console.error('hr_push_remove_failed', error?.code || error?.name || 'Error');
+    return NextResponse.json({ error: '無法儲存通知設定。', en: 'Unable to save notification settings.' }, { status: 503 });
+  }
+}
