+  async function lineTarget(key) {
+    const text = String(key || '');
+    let rows;
+    if (text.startsWith('member:') && /^\d+$/.test(text.slice(7))) {
+      rows = await query("SELECT line_user_id FROM hr_members WHERE id=$1 AND active=TRUE AND COALESCE(line_user_id,'')<>'' LIMIT 1", [Number(text.slice(7))]);
+    } else if (text.startsWith('admin:') && text.length > 6) {
+      rows = await query("SELECT line_user_id FROM hr_members WHERE lower(email)=$1 AND active=TRUE AND COALESCE(line_user_id,'')<>'' LIMIT 1", [text.slice(6).toLowerCase()]);
+    } else return null;
+    const lineUserId = rows[0]?.line_user_id;
+    if (!lineUserId) return null;
+    let language = 'zh';
+    try {
+      const prefs = await query('SELECT preferred_language FROM hr_line_member_settings WHERE line_user_id=$1', [lineUserId]);
