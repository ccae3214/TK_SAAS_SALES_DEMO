+  for (const name of ['HR_PUSH_VAPID_PUBLIC_KEY', 'HR_PUSH_VAPID_PRIVATE_KEY', 'HR_CALL_LINE_NOTIFY']) { assert.ok(read('docker-compose.yml').includes(name), name); assert.ok(read('.env.example').includes(name), name); }
+  assert.match(read('src/lib/hr-call-client.js'), /t: 'vis'/);
