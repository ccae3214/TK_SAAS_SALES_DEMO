index 60cf6c8..c6baa2e 100644
--- a/server.js
+++ b/server.js
@@ -2,6 +2,8 @@ import { createServer } from "node:http";
 import next from "next";
 import { attachCallSignaling } from "./src/lib/hr-call-signaling.js";
 import { callSecret } from "./src/lib/hr-call-ticket.js";
+import { CallHub } from "./src/lib/hr-call-signaling.js";
+import { createCallNotifier } from "./src/lib/hr-call-notify.js";
 
 const dev = process.env.NODE_ENV !== "production";
 
@@ -20,7 +22,12 @@ app.prepare().then(() => {
 
   // 聊天室通話的信令（WebSocket：/api/hr/call/ws）。沒有設定密鑰時不啟用，網站其他功能不受影響。
   const callSigningSecret = callSecret();
-  if (callSigningSecret) attachCallSignaling(httpServer, { secret: callSigningSecret });
+  if (callSigningSecret) {
+    // 受邀者沒開著網頁時，改用推播與 LINE 通知（設定見 .env.example）。
+    const notifier = createCallNotifier();
+    const hub = new CallHub({ secret: callSigningSecret, onRing: info => notifier.ring(info), onStop: info => notifier.stop(info) });
