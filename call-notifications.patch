diff --git a/public/hr-sw.js b/public/hr-sw.js
new file mode 100644
index 0000000..2e87099
--- /dev/null
+++ b/public/hr-sw.js
@@ -0,0 +1,58 @@
+/* 來電推播的 Service Worker：網站沒開著時，也能顯示「某某正在撥打給你」的系統通知。
+   只處理推播與點通知，不快取任何頁面（避免登入後的資料被快取）。
+   通知文字由伺服器依會員語言產生，這裡不放中英文。 */
+self.addEventListener('install', () => self.skipWaiting());
+self.addEventListener('activate', event => event.waitUntil(self.clients.claim()));
+
+const ICON = '/icons/icon-192.png';
+
+async function closeByTag(tag) {
+  const list = await self.registration.getNotifications({ tag });
+  list.forEach(item => item.close());
+  return list.length;
+}
+
+async function handlePush(data) {
+  const roomId = Number(data.roomId) || 0;
+  if (data.type === 'call-stop') {
+    const closed = await closeByTag(`call-${roomId}`);
+    // 瀏覽器規定每則推播都要顯示通知（iPhone 尤其嚴格），沒有東西可收時就閃一下再關掉。
+    if (!closed) {
+      await self.registration.showNotification(data.title || '·', { tag: `stop-${roomId}`, silent: true, icon: ICON });
+      await new Promise(resolve => setTimeout(resolve, 800));
+      await closeByTag(`stop-${roomId}`);
+    }
+    return;
+  }
+  if (data.type === 'call-missed') {
+    await closeByTag(`call-${roomId}`);
+    await self.registration.showNotification(data.title || '', {
+      body: data.body || '', tag: `missed-${roomId}`, icon: ICON, badge: ICON, data: { url: data.url || '/' },
+    });
+    return;
+  }
+  if (data.type === 'call') {
+    await self.registration.showNotification(data.title || '', {
+      body: data.body || '', tag: `call-${roomId}`, renotify: true, requireInteraction: true,
+      vibrate: [300, 150, 300, 150, 300], icon: ICON, badge: ICON, data: { url: data.url || '/' },
+    });
+  }
+}
+
+self.addEventListener('push', event => {
+  let data = {};
+  try { data = event.data ? event.data.json() : {}; } catch { data = {}; }
+  event.waitUntil(handlePush(data && typeof data === 'object' ? data : {}));
+});
+
+self.addEventListener('notificationclick', event => {
+  event.notification.close();
+  const target = new URL(event.notification.data?.url || '/', self.location.origin);
+  if (target.origin !== self.location.origin) return;
+  event.waitUntil((async () => {
+    const windows = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+    const open = windows.find(item => new URL(item.url).origin === self.location.origin);
+    if (open) { await open.focus(); return; }
+    await self.clients.openWindow(target.href);
+  })());
+});
diff --git a/scripts/generate-vapid-keys.mjs b/scripts/generate-vapid-keys.mjs
new file mode 100644
index 0000000..c505240
--- /dev/null
+++ b/scripts/generate-vapid-keys.mjs
@@ -0,0 +1,7 @@
+// 產生來電推播（Web Push）用的 VAPID 金鑰。執行：node scripts/generate-vapid-keys.mjs
+// 把輸出的兩行貼進 .env（私鑰不要外流、不要 commit），再重建 app 容器。金鑰換掉後，所有人要重新開啟「來電通知」。
+import webPush from 'web-push';
+
+const keys = webPush.generateVAPIDKeys();
+console.log(`HR_PUSH_VAPID_PUBLIC_KEY=${keys.publicKey}`);
+console.log(`HR_PUSH_VAPID_PRIVATE_KEY=${keys.privateKey}`);
