+    } catch { /* 沒有語言設定資料表時用中文 */ }
+    return { lineUserId, language };
+  }
+
+  async function lineTo(keys, call) {
+    if (!lineEnabled || !fetchImpl) return 0;
+    const url = publicSiteUrl(env);
+    let sent = 0;
+    for (const key of keys.slice(0, MAX_LINE_RECIPIENTS)) {
+      const cooldownKey = `${key}|${call.roomId}`;
+      if (now() - (lineSent.get(cooldownKey) || 0) < LINE_COOLDOWN_MS) continue;
+      try {
+        const target = await lineTarget(key);
+        if (!target) continue;
+        lineSent.set(cooldownKey, now());
+        const response = await fetchImpl('https://api.line.me/v2/bot/message/push', {
+          method: 'POST',
+          headers: { Authorization: `Bearer ${lineToken}`, 'Content-Type': 'application/json' },
+          body: JSON.stringify({ to: target.lineUserId, messages: [{ type: 'text', text: buildLineCallText({ language: target.language, from: call.from, video: call.video, url }) }] }),
+          signal: AbortSignal.timeout(8000),
+        });
+        if (response.ok) sent += 1; else log.warn?.('hr_call_line_failed', response.status);
+      } catch (error) { log.warn?.('hr_call_line_failed', error?.name || 'Error'); }
+    }
+    if (lineSent.size > 2000) for (const [item, at] of lineSent) if (now() - at > LINE_COOLDOWN_MS) lineSent.delete(item);
+    return sent;
+  }
+
+  return {
+    // 來電：keys 是目前沒有「開著且在前景」的網頁連線的受邀者。
+    async ring({ roomId, from, video, keys }) {
+      const call = { roomId, from, video: !!video };
+      const [push, line] = await Promise.allSettled([
+        pushTo(keys, language => buildPushPayload('start', { language, from, video, roomId }), { TTL: 60, urgency: 'high', topic: `call${roomId}` }),
+        lineTo(keys, call),
+      ]);
+      return { push: push.status === 'fulfilled' ? push.value : 0, line: line.status === 'fulfilled' ? line.value : 0 };
+    },
+    // 通話結束或已有人接聽：收掉通知。沒人接聽（no-answer）時改成「未接來電」。
+    async stop({ roomId, reason, from, video, keys }) {
+      if (!keys?.length) return 0;
+      const missed = reason === 'no-answer';
+      return pushTo(keys,
+        language => buildPushPayload(missed ? 'missed' : 'stop', { language, from, video, roomId }),
+        { TTL: missed ? 3600 : 60, urgency: missed ? 'normal' : 'high', topic: missed ? `missed${roomId}` : `call${roomId}` });
+    },
+  };
+}
