+      await ensure();
+      await query(
+        `INSERT INTO hr_push_subscriptions(participant_key,endpoint,p256dh,auth,language,user_agent)
+         VALUES($1,$2,$3,$4,$5,$6)
+         ON CONFLICT(endpoint) DO UPDATE SET participant_key=EXCLUDED.participant_key,p256dh=EXCLUDED.p256dh,auth=EXCLUDED.auth,
+           language=EXCLUDED.language,user_agent=EXCLUDED.user_agent,updated_at=NOW()`,
+        [key, subscription.endpoint, subscription.p256dh, subscription.auth, language, String(userAgent).slice(0, 300)]);
+      await query(
+        `DELETE FROM hr_push_subscriptions WHERE participant_key=$1 AND id NOT IN (
+           SELECT id FROM hr_push_subscriptions WHERE participant_key=$1 ORDER BY updated_at DESC, id DESC LIMIT $2)`,
+        [key, MAX_SUBSCRIPTIONS_PER_KEY]);
+    },
+    async remove(key, endpoint) {
+      await ensure();
+      await query('DELETE FROM hr_push_subscriptions WHERE participant_key=$1 AND endpoint=$2', [key, endpoint]);
+    },
+    async removeEndpoint(endpoint) {
+      await ensure();
+      await query('DELETE FROM hr_push_subscriptions WHERE endpoint=$1', [endpoint]);
+    },
+    async forKeys(keys) {
+      if (!keys.length) return [];
+      await ensure();
+      return query('SELECT participant_key,endpoint,p256dh,auth,language FROM hr_push_subscriptions WHERE participant_key=ANY($1::text[])', [keys]);
+    },
+    async has(key) {
+      await ensure();
+      return (await query('SELECT 1 FROM hr_push_subscriptions WHERE participant_key=$1 LIMIT 1', [key])).length > 0;
+    },
+  };
+}
+
+export const pushStore = createPushStore();
