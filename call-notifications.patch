+import { buildLineCallText, buildPushPayload, normalizePushLanguage, publicSiteUrl, pushConfig } from './hr-push-core.js';
+import { pushStore } from './hr-push-store.js';
+import { query as defaultQuery } from './db.js';
+
+// 有人撥打通話時，通知「網頁沒開著」的受邀者：
+//   1. Web Push：手機／電腦的系統通知（對方要先在網站上開啟「來電通知」）。
+//   2. LINE：LINE 官方帳號傳一則訊息（只傳給有綁定 LINE 的會員；HR_CALL_LINE_NOTIFY=0 可關閉）。
+// 兩個管道各自獨立，任何一個失敗都不影響通話本身。只用相對路徑 import，server.js 可以直接載入。
+export const MAX_PUSH_RECIPIENTS = 100;
+export const MAX_LINE_RECIPIENTS = 20;
+export const LINE_COOLDOWN_MS = 2 * 60 * 1000;
+
+export function createCallNotifier({
+  store = pushStore, query = defaultQuery, env = process.env, fetchImpl = globalThis.fetch,
+  sendPush = null, now = () => Date.now(), log = console,
+} = {}) {
+  const config = pushConfig(env);
