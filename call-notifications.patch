diff --git a/src/components/HrPushNotifications.jsx b/src/components/HrPushNotifications.jsx
new file mode 100644
index 0000000..a926ae1
--- /dev/null
+++ b/src/components/HrPushNotifications.jsx
@@ -0,0 +1,124 @@
+"use client";
+
+import { useCallback, useEffect, useState } from 'react';
+import { Bell, BellRing, X } from 'lucide-react';
+import { useLanguage } from '@/context/LanguageContext';
+import { PUSH_COPY } from '@/lib/hr-push-core';
+import { copyFor, normalizeLanguage } from '@/lib/language';
+import styles from './HrPushNotifications.module.css';
+
+// 「開啟來電通知」：讓手機在網站沒開著時，也會收到「某某正在撥打給你」的系統通知。
+// iPhone 要先加到主畫面、從桌面圖示開啟才支援；不支援或伺服器沒設定時不顯示按鈕。
+function keyToBytes(base64) {
+  const padded = `${base64}${'='.repeat((4 - (base64.length % 4)) % 4)}`.replace(/-/g, '+').replace(/_/g, '/');
+  const raw = window.atob(padded);
+  return Uint8Array.from(raw, char => char.charCodeAt(0));
+}
+
+async function api(method, body) {
+  const response = await fetch('/api/hr/push', {
+    method, credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.error || 'push_api_failed');
+  return data;
+}
+
+export default function HrPushNotifications() {
+  const { lang } = useLanguage();
+  const language = normalizeLanguage(lang);
+  const t = copyFor(PUSH_COPY, language);
+  const [status, setStatus] = useState('loading'); // loading | hidden | off | on | denied
+  const [publicKey, setPublicKey] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [dialog, setDialog] = useState(null); // null | 'manage' | 'denied' | 'failed'
+
+  const syncSubscription = useCallback(async subscription => {
+    await api('POST', { subscription: subscription.toJSON(), language });
+  }, [language]);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      const supported = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
+      if (!supported) { setStatus('hidden'); return; }
+      try {
+        const info = await api('GET');
+        if (!info.enabled || !info.publicKey) { if (!cancelled) setStatus('hidden'); return; }
+        const registration = await navigator.serviceWorker.register('/hr-sw.js');
+        const subscription = await registration.pushManager.getSubscription();
+        if (cancelled) return;
+        setPublicKey(info.publicKey);
+        if (Notification.permission === 'denied') { setStatus('denied'); return; }
+        if (subscription && Notification.permission === 'granted') {
+          await syncSubscription(subscription).catch(() => {});
+          if (!cancelled) setStatus('on');
+        } else setStatus('off');
+      } catch { if (!cancelled) setStatus('hidden'); }
+    })();
+    return () => { cancelled = true; };
+  }, [syncSubscription]);
+
+  useEffect(() => {
+    if (!dialog) return undefined;
+    const onKey = event => { if (event.key === 'Escape') setDialog(null); };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [dialog]);
+
+  if (status === 'loading' || status === 'hidden') return null;
+
+  const turnOn = async () => {
+    if (busy) return;
+    setBusy(true);
+    try {
+      const permission = await Notification.requestPermission();
+      if (permission !== 'granted') { setStatus(permission === 'denied' ? 'denied' : 'off'); if (permission === 'denied') setDialog('denied'); return; }
+      const registration = await navigator.serviceWorker.ready;
+      const subscription = (await registration.pushManager.getSubscription())
+        || await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: keyToBytes(publicKey) });
+      await syncSubscription(subscription);
+      setStatus('on');
+      setDialog('manage');
+    } catch { setDialog('failed'); } finally { setBusy(false); }
+  };
+
+  const turnOff = async () => {
+    if (busy) return;
+    setBusy(true);
+    try {
+      const registration = await navigator.serviceWorker.ready;
+      const subscription = await registration.pushManager.getSubscription();
+      if (subscription) { await api('DELETE', { endpoint: subscription.endpoint }).catch(() => {}); await subscription.unsubscribe(); }
+      setStatus('off');
+      setDialog(null);
+    } catch { setDialog('failed'); } finally { setBusy(false); }
+  };
+
+  const onClick = () => {
+    if (status === 'on') setDialog('manage');
+    else if (status === 'denied') setDialog('denied');
+    else void turnOn();
+  };
+
+  const label = status === 'on' ? t.enabled : t.enable;
+  const Icon = status === 'on' ? BellRing : Bell;
+
+  return <>
+    <button type="button" className={styles.button} onClick={onClick} disabled={busy} aria-label={label} title={label}>
+      <Icon size={16} aria-hidden="true" /><span className={styles.label}>{busy ? t.working : label}</span>
+    </button>
+    {dialog && <div className={styles.overlay} role="presentation" onClick={() => setDialog(null)}>
+      <div className={styles.dialog} role="dialog" aria-modal="true" aria-labelledby="hr-push-title" onClick={event => event.stopPropagation()}>
+        <div className={styles.head}>
+          <h2 id="hr-push-title">{dialog === 'manage' ? t.enabled : t.enable}</h2>
+          <button type="button" className={styles.close} aria-label={t.disable} onClick={() => setDialog(null)}><X size={18} aria-hidden="true" /></button>
+        </div>
+        <p className={styles.text}>{dialog === 'manage' ? t.hint : dialog === 'denied' ? t.denied : t.failed}</p>
+        {dialog === 'manage' && <button type="button" className={styles.off} onClick={turnOff} disabled={busy}>{t.disable}</button>}
+      </div>
+    </div>}
+  </>;
+}
