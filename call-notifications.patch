+  const lineEnabled = !!lineToken && env.HR_CALL_LINE_NOTIFY !== '0';
+  const lineSent = new Map();
+  let sender = sendPush;
+
+  async function getSender() {
+    if (sender) return sender;
+    if (!config) return null;
+    const webPush = (await import('web-push')).default;
+    webPush.setVapidDetails(config.subject, config.publicKey, config.privateKey);
+    sender = (subscription, body, options) => webPush.sendNotification(subscription, body, options);
+    return sender;
+  }
+
+  async function pushTo(keys, makePayload, options) {
+    if (!config && !sendPush) return 0;
+    const send = await getSender();
+    if (!send || !keys.length) return 0;
+    const rows = await store.forKeys(keys.slice(0, MAX_PUSH_RECIPIENTS));
+    let sent = 0;
+    await Promise.all(rows.map(async row => {
+      try {
+        await send({ endpoint: row.endpoint, keys: { p256dh: row.p256dh, auth: row.auth } }, JSON.stringify(makePayload(normalizePushLanguage(row.language))), options);
