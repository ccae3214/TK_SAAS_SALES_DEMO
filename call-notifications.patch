+++ b/src/lib/hr-push-core.js
@@ -0,0 +1,120 @@
+// 來電推播（Web Push）與 LINE 通知的共用邏輯：訂閱驗證、通知文字（中／英／他加祿語）。
+// 不 import '@/…'，伺服器（server.js）與 node:test 都可以直接載入。
+
+export const PUSH_LANGUAGES = ['zh', 'en', 'tl'];
+export const MAX_SUBSCRIPTIONS_PER_KEY = 8;
+
+// 只接受主流瀏覽器的推播服務網址；否則會員可以填任意網址，讓伺服器對該網址發出請求（SSRF）。
+const PUSH_HOSTS = [
+  /^fcm\.googleapis\.com$/i,
+  /^updates\.push\.services\.mozilla\.com$/i,
+  /^[a-z0-9-]+\.push\.services\.mozilla\.com$/i,
+  /^[a-z0-9.-]+\.push\.apple\.com$/i,
+  /^[a-z0-9.-]+\.notify\.windows\.com$/i,
+];
+
+export function isAllowedPushEndpoint(value) {
+  try {
+    const url = new URL(String(value));
+    return url.protocol === 'https:' && !url.username && !url.password && !url.port && String(value).length <= 2048
+      && PUSH_HOSTS.some(pattern => pattern.test(url.hostname));
+  } catch { return false; }
+}
+
+const base64Url = /^[A-Za-z0-9_-]+={0,2}$/;
+
+// 回傳整理後的訂閱，格式不正確就回傳 null。
+export function normalizeSubscription(input) {
+  const endpoint = String(input?.endpoint || '');
+  const p256dh = String(input?.keys?.p256dh || '');
+  const auth = String(input?.keys?.auth || '');
+  if (!isAllowedPushEndpoint(endpoint)) return null;
+  if (!base64Url.test(p256dh) || p256dh.length < 40 || p256dh.length > 200) return null;
+  if (!base64Url.test(auth) || auth.length < 8 || auth.length > 64) return null;
+  return { endpoint, p256dh, auth };
+}
+
+export function normalizePushLanguage(value) {
+  const text = String(value || '').toLowerCase();
+  return PUSH_LANGUAGES.includes(text) ? text : 'zh';
+}
+
+const cleanName = value => String(value || '').replace(/[\r\n\t]+/g, ' ').trim().slice(0, 80);
+
+const COPY = {
+  zh: {
+    voice: name => ({ title: `📞 ${name} 正在撥打語音通話給你`, body: '點一下開啟網站並接聽。' }),
+    video: name => ({ title: `🎥 ${name} 正在撥打視訊通話給你`, body: '點一下開啟網站並接聽。' }),
+    missed: name => ({ title: `未接來電：${name}`, body: '對方撥打時你沒有接聽。' }),
+    line: (name, video, url) => `${video ? '🎥' : '📞'} ${name} 正在${video ? '視訊' : '語音'}通話撥打給你。\n請在 45 秒內開啟網站接聽：\n${url}`,
+  },
+  en: {
+    voice: name => ({ title: `📞 ${name} is calling you`, body: 'Tap to open the site and answer.' }),
+    video: name => ({ title: `🎥 ${name} is video calling you`, body: 'Tap to open the site and answer.' }),
+    missed: name => ({ title: `Missed call: ${name}`, body: 'You did not answer when they called.' }),
+    line: (name, video, url) => `${video ? '🎥' : '📞'} ${name} is ${video ? 'video ' : ''}calling you.\nOpen the site within 45 seconds to answer:\n${url}`,
+  },
+  tl: {
+    voice: name => ({ title: `📞 Tumatawag si ${name} sa iyo`, body: 'I-tap para buksan ang site at sagutin.' }),
+    video: name => ({ title: `🎥 Nag-video call si ${name} sa iyo`, body: 'I-tap para buksan ang site at sagutin.' }),
+    missed: name => ({ title: `Hindi nasagot na tawag: ${name}`, body: 'Hindi mo nasagot nang tumawag sila.' }),
+    line: (name, video, url) => `${video ? '🎥' : '📞'} Tumatawag si ${name} sa iyo${video ? ' (video)' : ''}.\nBuksan ang site sa loob ng 45 segundo para sagutin:\n${url}`,
+  },
+};
+
+// kind：start（來電）、stop（對方已掛斷／已有人接聽，收掉通知）、missed（未接來電）。
+export function buildPushPayload(kind, { language = 'zh', from = '', video = false, roomId = 0 } = {}) {
+  const lang = normalizePushLanguage(language);
+  const name = cleanName(from) || (lang === 'zh' ? '有人' : lang === 'tl' ? 'Isang tao' : 'Someone');
+  const room = Number.isSafeInteger(Number(roomId)) ? Number(roomId) : 0;
+  if (kind === 'stop') return { type: 'call-stop', roomId: room };
+  const copy = kind === 'missed' ? COPY[lang].missed(name) : (video ? COPY[lang].video(name) : COPY[lang].voice(name));
+  return { type: kind === 'missed' ? 'call-missed' : 'call', roomId: room, url: '/', ...copy };
+}
+
+export function buildLineCallText({ language = 'zh', from = '', video = false, url = '' } = {}) {
+  const lang = normalizePushLanguage(language);
+  const name = cleanName(from) || (lang === 'zh' ? '有人' : lang === 'tl' ? 'Isang tao' : 'Someone');
+  return COPY[lang].line(name, !!video, url).slice(0, 4500);
+}
+
+// 網站對外的網址（LINE 訊息裡的連結）。只接受 http(s)，沒設定就回傳空字串（不送連結）。
+export function publicSiteUrl(env = {}) {
+  for (const value of [env.APP_ORIGIN, env.NEXTAUTH_URL]) {
+    try {
+      const url = new URL(String(value || ''));
+      if (['https:', 'http:'].includes(url.protocol) && !url.username && !url.password) return url.origin + '/';
+    } catch { /* 試下一個 */ }
+  }
+  return '';
+}
+
+export function pushConfig(env = {}) {
+  const publicKey = String(env.HR_PUSH_VAPID_PUBLIC_KEY || '').trim();
+  const privateKey = String(env.HR_PUSH_VAPID_PRIVATE_KEY || '').trim();
+  if (!base64Url.test(publicKey) || !base64Url.test(privateKey)) return null;
+  const first = String(env.HR_ADMIN_EMAILS || env.ADMIN_EMAILS || '').split(',').map(item => item.trim()).find(item => /^[^@\s]+@[^@\s]+$/.test(item));
+  const subject = String(env.HR_PUSH_SUBJECT || '').trim() || (first ? `mailto:${first}` : publicSiteUrl(env)) || 'mailto:admin@example.com';
+  return { publicKey, privateKey, subject };
+}
+
+export const PUSH_COPY = {
+  zh: {
+    enable: '開啟來電通知', enabled: '來電通知已開啟', disable: '關閉', working: '設定中…',
+    denied: '通知權限被關閉了。請到瀏覽器或手機的網站設定，把這個網站的通知改成「允許」。',
+    failed: '無法開啟來電通知，請稍後再試。',
+    hint: '開啟後，即使沒有開著網站，有人撥打給你時手機也會收到通知。點通知開啟網站後就能接聽。',
+  },
+  en: {
+    enable: 'Turn on call alerts', enabled: 'Call alerts are on', disable: 'Turn off', working: 'Working…',
+    denied: 'Notifications are blocked. Open your browser or phone site settings and set notifications for this site to "Allow".',
+    failed: 'Unable to turn on call alerts. Please try again later.',
+    hint: 'Once on, your phone will notify you when someone calls, even if the site is not open. Tap the notification to open the site and answer.',
+  },
+  tl: {
+    enable: 'I-on ang mga alerto sa tawag', enabled: 'Naka-on ang mga alerto sa tawag', disable: 'I-off', working: 'Sandali lang…',
+    denied: 'Naka-block ang mga notification. Buksan ang site settings ng browser o telepono at itakda sa "Allow" ang notifications para sa site na ito.',
+    failed: 'Hindi ma-on ang mga alerto sa tawag. Pakisubukan muli mamaya.',
+    hint: 'Kapag naka-on, aabisuhan ang telepono mo kapag may tumawag, kahit hindi nakabukas ang site. I-tap ang notification para buksan ang site at sagutin.',
+  },
+};
