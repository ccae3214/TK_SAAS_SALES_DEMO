+import { query as defaultQuery } from './db.js';
+import { MAX_SUBSCRIPTIONS_PER_KEY } from './hr-push-core.js';
+
+// 推播訂閱資料表。伺服器（server.js 的通話信令）與 Next API 路由共用，所以只用相對路徑 import。
+// participant_key 與通話的使用者識別相同：member:編號 或 admin:email。
+export function createPushStore(query = defaultQuery) {
