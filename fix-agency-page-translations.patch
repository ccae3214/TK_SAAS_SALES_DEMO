+// 含數字、名稱的句子。translate 用來翻譯句子裡的片段（可省略）。沒有符合的句型時回傳 undefined。
+export function translateAgencyPattern(text, translate = value => value) {
+  let m;
+  if ((m = text.match(/^(\d+) 件$/))) return plural(m[1], 'case', 'cases');
+  if ((m = text.match(/^(\d+) 位機構成員$/))) return plural(m[1], 'agency member', 'agency members');
+  if ((m = text.match(/^(\d+) 件相關案件$/))) return plural(m[1], 'related case', 'related cases');
+  if ((m = text.match(/^(\d+) 位所屬雇主 · (\d+) 位所屬工人$/))) return `${plural(m[1], 'employer', 'employers')} · ${plural(m[2], 'worker', 'workers')}`;
+  if ((m = text.match(/^(所有認證紀錄|等待您回應|已相互認證|等待對方確認|已拒絕或解除)（(\d+)）$/))) return `${COUNTED_TITLE_EN[m[1]]} (${m[2]})`;
+  if ((m = text.match(/^目前還沒有已認證的(菲律賓仲介|台灣仲介)。$/))) return `There are no certified ${AGENCY_SIDE_PLURAL_EN[m[1]]} yet.`;
+  if ((m = text.match(/^沒有可再申請的(菲律賓仲介|台灣仲介)。$/))) return `There are no more ${AGENCY_SIDE_PLURAL_EN[m[1]]} to request certification with.`;
+  if ((m = text.match(/^已送出申請，等待(菲律賓仲介|台灣仲介)確認。$/))) return `Request sent. Waiting for the ${AGENCY_SIDE_EN[m[1]]} to confirm.`;
+  if ((m = text.match(/^確定(解除|撤回)「(.+)」？$/))) return `${m[1] === '解除' ? 'End the certification' : 'Withdraw the request'} “${m[2]}”?`;
+  if ((m = text.match(/^確定解除與「(.+)」的認證？解除後雙方不能再安排新的面試、錄用或辦件。$/))) return `End the certification with “${m[1]}”? After that, neither side can arrange new interviews, hires or case work.`;
+  if ((m = text.match(/^更新 (\d{4}\/\d{1,2}\/\d{1,2}|—)$/))) return `Updated ${m[1]}`;
+  if ((m = text.match(/^台灣仲介「(.+)」與菲律賓仲介「(.+)」尚未完成相互認證，不能建立案件。$/))) return `Taiwan agency “${m[1]}” and Philippine agency “${m[2]}” have not completed mutual certification, so a case cannot be created.`;
+  if ((m = text.match(/^(訓練中心|菲律賓仲介|台灣仲介)辦理$/))) return `Handled by ${OWNER_EN[m[1]]}`;
+  if ((m = text.match(/^業務：(.+)$/))) return `Representative: ${m[1]}`;
+  if ((m = text.match(/^退件：(.*)$/))) return `Returned: ${m[1]}`;
+  if ((m = text.match(/^確定刪除需求單 #(\d+)？刪除後無法復原。$/))) return `Delete request #${m[1]}? This cannot be undone.`;
+  if ((m = text.match(/^撤回「(.+)」的推薦？只會撤回尚未安排面試的推薦，工作者資料與紀錄都會保留。$/))) return `Withdraw the recommendation of “${m[1]}”? Only recommendations without a scheduled interview can be withdrawn; the worker’s data and records are kept.`;
+  if ((m = text.match(/^符合此工作類別且尚未有雇主的工作者（(\d+)）$/))) return `Workers matching this job category who have no employer yet (${m[1]})`;
+  if ((m = text.match(/^退回「(.+)」$/))) return `Return “${m[1]}”`;
+  if ((m = text.match(/^(.+) 取證進度$/))) return `${translate(m[1])} certification progress`;
+  if ((m = text.match(/^剩 (\d+) 天$/))) return `${plural(m[1], 'day', 'days')} left`;
+  if ((m = text.match(/^(\d+) 天後$/))) return `in ${plural(m[1], 'day', 'days')}`;
+  if ((m = text.match(/^已過 (\d+) 天$/))) return `${plural(m[1], 'day', 'days')} ago`;
+  if ((m = text.match(/^考證日期（(.+)）$/))) return `Exam date (${m[1]})`;
+  if ((m = text.match(/^證照辦件日期（(.+)）$/))) return `Certificate filing date (${m[1]})`;
+  return undefined;
+}
