--- /dev/null
+++ b/tests/hr-agency-translations.test.mjs
@@ -0,0 +1,103 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import { AGENCY_PAGE_EN, translateAgencyPattern } from '../src/lib/hr-translations-agency.js';
+import { OWNER_LABELS, nextActionForStage } from '../src/lib/hr-case-flow.js';
+import { MATCH_STEPS } from '../src/lib/hr-workflow.js';
+import {
+  AGENCY_ADMIN_REQUIRED_MESSAGE, CERTIFICATION_ACTIONS, CERTIFICATION_SOURCE_LABELS, CERTIFICATION_STATUS_LABELS, actionLabel,
+} from '../src/lib/hr-agency-certification.js';
+
+// 畫面上實際會出現的文字（含變數代入後）→ 這個檔案負責的英文。
+const translate = text => AGENCY_PAGE_EN[text] ?? translateAgencyPattern(text);
+const CJK = /[㐀-鿿]/;
+const read = path => readFileSync(new URL(path, import.meta.url), 'utf8');
+
+test('every dictionary entry has a non-empty English value (only the LINE menu keyword may stay Chinese)', () => {
+  for (const [zh, en] of Object.entries(AGENCY_PAGE_EN)) {
+    assert.ok(en.trim(), `empty translation for ${zh}`);
+    assert.ok(!CJK.test(en.replace('“會員類型”', '')), `English text still has Chinese: ${zh}`);
+  }
+});
+
+test('mutual certification panel text (both agency sides and admin) is translated', () => {
+  const rendered = [
+    '相互認證', '台灣仲介相互認證', '菲律賓仲介相互認證', '台灣／菲律賓仲介相互認證', '等待您回應（2）', '已相互認證（0）', '等待對方確認（1）',
+    '已拒絕或解除（3）', '所有認證紀錄（5）', '目前還沒有已認證的菲律賓仲介。', '目前還沒有已認證的台灣仲介。', '沒有可再申請的菲律賓仲介。', '沒有可再申請的台灣仲介。',
+    '已送出申請，等待菲律賓仲介確認。', '已送出申請，等待台灣仲介確認。', '確定解除「甲 ⇄ 乙」？', '確定撤回「甲 ⇄ 乙」？',
+    '確定解除與「乙」的認證？解除後雙方不能再安排新的面試、錄用或辦件。', '更新 2026/11/16', '更新 —', '· 認證日期', '· 更新', '申請日期',
+    AGENCY_ADMIN_REQUIRED_MESSAGE,
+    ...Object.values(CERTIFICATION_STATUS_LABELS), ...Object.values(CERTIFICATION_SOURCE_LABELS),
+  ];
+  for (const text of rendered) assert.ok(translate(text), `no English for: ${text}`);
+  assert.equal(translate('菲律賓仲介相互認證'), 'Philippine agency mutual certification');
+  assert.equal(translate('等待您回應（2）'), 'Awaiting your response (2)');
+  assert.equal(translate('確定解除「甲 ⇄ 乙」？'), 'End the certification “甲 ⇄ 乙”?');
+  assert.equal(translate('確定撤回「甲 ⇄ 乙」？'), 'Withdraw the request “甲 ⇄ 乙”?');
+});
+
+test('every certification button label is translated', () => {
+  const rows = [{ status: 'pending' }, { status: 'certified' }, { status: 'rejected' }, { status: 'revoked' }];
+  for (const action of CERTIFICATION_ACTIONS) for (const row of rows) {
+    const label = actionLabel(action, row);
+    assert.ok(translate(label), `no English for button: ${label} (${action}/${row.status})`);
+  }
+});
+
+test('employer requests and matching progress, and the next-step prompts, are translated', () => {
+  for (const text of [
+    '雇主需求與媒合進度', '雇主挑選工作者後，系統會直接通知台灣與菲律賓仲介。', '進行中需求依目前分工處理；已額滿或取消只保留紀錄。', '配對進度',
+    '雇主可挑選符合工作類型的工作者；管理者也可指派合作菲律賓仲介。', '確認負責業務，追蹤雇主選工、錄用與來台進度。',
+    '符合此工作類別且尚未有雇主的工作者（4）', '業務：王先生', '等待指派', '前往我的需求', '查看人選', '建立案件後才能確認以下項目。',
+    ...['仲介分工', '挑選／推薦人選'].filter(step => MATCH_STEPS.includes(step)),
+    ...['medical_training', 'application', 'arrangement'].map(nextActionForStage),
+    ...Object.values(OWNER_LABELS).map(owner => `${owner}辦理`),
+  ]) assert.ok(translate(text), `no English for: ${text}`);
+  assert.equal(translate('台灣仲介辦理'), 'Handled by the Taiwan agency');
+  assert.equal(translate('由菲律賓仲介辦理 OEC 與簽證'), 'The Philippine agency handles the OEC and visa');
+});
+
+test('case counts are singular/plural English instead of staying Chinese', () => {
+  assert.equal(translate('0 件'), '0 cases');
+  assert.equal(translate('1 件'), '1 case');
+  assert.equal(translate('3 件'), '3 cases');
+  assert.equal(translate('1 位機構成員'), '1 agency member');
+  assert.equal(translate('5 位機構成員'), '5 agency members');
+  assert.equal(translate('1 件相關案件'), '1 related case');
+  assert.equal(translate('2 位所屬雇主 · 1 位所屬工人'), '2 employers · 1 worker');
+  assert.equal(translate('剩 1 天'), '1 day left');
+  assert.equal(translate('剩 5 天'), '5 days left');
+});
+
+test('confirm dialogs and certification progress text are translated', () => {
+  assert.equal(translate('確定刪除需求單 #12？刪除後無法復原。'), 'Delete request #12? This cannot be undone.');
+  assert.match(translate('撤回「Maria」的推薦？只會撤回尚未安排面試的推薦，工作者資料與紀錄都會保留。'), /^Withdraw the recommendation of “Maria”\?/);
+  assert.equal(translate('退回「PSA 出生證明」'), 'Return “PSA 出生證明”');
+  assert.equal(translate('退件：照片模糊'), 'Returned: 照片模糊');
+  assert.equal(translate('未開始'), 'Not started');
+  assert.equal(translate('取證進度已更新。'), 'Certification progress updated.');
+});
+
+test('unrelated text is left alone by the patterns', () => {
+  for (const text of ['備註', '3 件事', '更新', '更新失敗', '案件 #3', '']) assert.equal(translateAgencyPattern(text), undefined, text);
+});
+
+// 元件裡含變數的文字必須是「單一字串」，翻譯才接得起來；這裡守住不被改回成 {n} 與文字分開的寫法。
+test('components keep variable text in one string and the dictionary is wired into translateHrText', () => {
+  const certifications = read('../src/components/HrAgencyCertifications.jsx');
+  for (const piece of [
+    '{`所有認證紀錄（${rows.length}）`}', '{`等待您回應（${incoming.length}）`}', '{`已相互認證（${certified.length}）`}',
+    '{`等待對方確認（${outgoing.length}）`}', '{`已拒絕或解除（${closed.length}）`}', '{`${otherName}相互認證`}',
+    '{`目前還沒有已認證的${otherName}。`}', '{`沒有可再申請的${otherName}。`}', '{`更新 ${dateText(row.updated_at)}`}',
+  ]) assert.ok(certifications.includes(piece), `HrAgencyCertifications lost: ${piece}`);
+  assert.equal((certifications.match(/window\.confirm\(tx\(/g) || []).length, 2, 'both confirm dialogs must be translated');
+
+  const directory = read('../src/components/HrAgencyDirectory.jsx');
+  assert.ok(directory.includes('{`${snapshot.members.length} 位機構成員`}') && directory.includes('{`${detail.cases.length} 件相關案件`}'));
+
+  const portal = read('../src/components/HrMemberPortal.jsx');
+  assert.equal((portal.match(/window\.confirm\(translateHrText\(/g) || []).length >= 2, true, 'portal confirm dialogs must be translated');
+
+  const translations = read('../src/lib/hr-translations.jsx');
+  assert.ok(translations.includes('AGENCY_PAGE_EN[trimmed]') && translations.includes('translateAgencyPattern(trimmed'), 'dictionary not wired into translateHrText');
+});
