---
 src/components/HrEmployerDocuments.jsx        |  2 +-
 src/components/HrEmployerDocuments.module.css | 72 +++++++++++++------
 2 files changed, 52 insertions(+), 22 deletions(-)

diff --git a/src/components/HrEmployerDocuments.jsx b/src/components/HrEmployerDocuments.jsx
index 6cab807..7a9fba9 100644
--- a/src/components/HrEmployerDocuments.jsx
+++ b/src/components/HrEmployerDocuments.jsx
@@ -79,7 +79,7 @@ export default function HrEmployerDocuments({ employers = [], embedded = false }
 
   const dateOf = value => new Date(value).toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-TW');
 
-  return <section className={`${styles.panel} ${embedded ? styles.embedded : ''}`} aria-label={t.title}>
+  return <section className={`${styles.panel} ${embedded ? styles.embedded : styles.card}`} aria-label={t.title}>
     {!embedded && <h2>{t.title}</h2>}
     <p className={styles.lead}>{t.lead}</p>
     {message && <p className={message.type === 'error' ? styles.error : styles.success} role={message.type === 'error' ? 'alert' : 'status'}>{message.text}</p>}
diff --git a/src/components/HrEmployerDocuments.module.css b/src/components/HrEmployerDocuments.module.css
index b7d1053..4467b96 100644
--- a/src/components/HrEmployerDocuments.module.css
+++ b/src/components/HrEmployerDocuments.module.css
@@ -1,25 +1,55 @@
-.panel{margin:0 0 20px;padding:18px;border:1px solid #d9e0e7;border-radius:12px;background:#fff;color:#1f2933;font-family:Inter,"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif}
+/* 雇主核准函：外框沿用會員頁其他卡片（hr-member-card）的寬度、間距與標題樣式；
+   --ink / --line / --radius 等變數由 .hr-member-shell 提供，其他頁面（例如管理後台彈窗）則使用後面的預設值。 */
+.panel{box-sizing:border-box;color:var(--ink,#1f2933);font-family:Inter,"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif}
+.panel *,.panel *::before,.panel *::after{box-sizing:border-box}
+.card{max-width:1100px;margin:0 auto 18px;padding:24px;border:1px solid var(--line,#d9e0e7);border-radius:var(--radius,18px);background:#fff;box-shadow:var(--shadow-sm,none)}
 .embedded{margin:0;padding:0;border:0}
-.panel h2{margin:0 0 6px;font-size:1.1rem}
-.lead{margin:0 0 14px;color:#52606d;font-size:.9rem;line-height:1.6}
-.employer{padding:14px 0;border-top:1px solid #e4e9ee}
+.panel h2{display:flex;align-items:center;gap:10px;margin:0 0 8px;font-size:18px;font-weight:800;line-height:1.35;color:var(--ink,#1f2933)}
+.panel h2::before{content:'';flex:none;width:4px;height:18px;border-radius:4px;background:linear-gradient(var(--g-500,#2f9d7c),var(--g-700,#176b54))}
+.lead{margin:0 0 18px;color:var(--ink-2,#52606d);font-size:14px;line-height:1.65}
+
+.employer{padding:18px 0;border-top:1px solid var(--line-soft,#e4e9ee)}
 .employer:first-of-type{border-top:0;padding-top:0}
-.employer h3{margin:0 0 10px;font-size:1rem}
-.list{display:grid;gap:8px;margin:0 0 12px;padding:0;list-style:none}
-.item{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px;border:1px solid #e4e9ee;border-radius:10px}
-.itemMain{display:grid;gap:2px;min-width:0;flex:1 1 220px}
-.itemMain strong{overflow-wrap:anywhere}
-.itemMain small{color:#667085}
-.badge{display:inline-block;margin-right:6px;padding:2px 8px;border-radius:999px;background:#dcf3e5;color:#14532d;font-size:.78rem;font-weight:700}
-.actions{display:flex;flex-wrap:wrap;gap:6px}
-.actions a,.actions button,.upload button{padding:6px 12px;border:1px solid #b6c2cf;border-radius:8px;background:#fff;color:#1f2933;font:inherit;font-size:.85rem;text-decoration:none;cursor:pointer}
-.actions button:disabled,.upload button:disabled{opacity:.55;cursor:not-allowed}
-.empty{margin:0 0 12px;color:#667085;font-size:.9rem}
-.upload{display:grid;gap:10px;max-width:560px;padding:12px;border:1px dashed #b6c2cf;border-radius:10px;background:#f8fafb}
-.upload label{display:grid;gap:4px;font-size:.85rem;color:#334155}
-.upload input[type="text"]{padding:7px 9px;border:1px solid #b6c2cf;border-radius:8px;font:inherit}
-.upload .primary{justify-self:start;background:#176b54;border-color:#176b54;color:#fff;font-weight:700}
-.hint{margin:0;color:#667085;font-size:.8rem}
-.error,.success{margin:0 0 12px;padding:10px 12px;border-radius:8px;font-size:.88rem}
+.employer:last-child{padding-bottom:0}
+.employer h3{margin:0 0 12px;font-size:16px;font-weight:800;color:var(--ink,#1f2933)}
+
+.list{display:grid;gap:10px;margin:0 0 16px;padding:0;list-style:none}
+.item{display:flex;align-items:center;justify-content:space-between;gap:12px 16px;padding:12px 16px;border:1px solid var(--line-soft,#e4e9ee);border-radius:12px;background:var(--g-50,#f8fafb)}
+.itemMain{display:grid;gap:4px;min-width:0;flex:1 1 260px}
+.itemMain strong{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;min-width:0;font-size:14.5px;line-height:1.45;overflow-wrap:anywhere}
+.itemMain small{color:var(--ink-3,#667085);font-size:12.5px;line-height:1.5;overflow-wrap:anywhere}
+.badge{display:inline-flex;align-items:center;flex:none;padding:2px 10px;border-radius:999px;background:#dcf3e5;color:#14532d;font-size:12px;font-weight:700;line-height:1.5;white-space:nowrap}
+
+.actions{display:flex;flex:none;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:8px}
+.actions a,.actions button{display:inline-flex;align-items:center;justify-content:center;min-width:64px;min-height:36px;padding:6px 14px;border:1px solid #cfdad4;border-radius:10px;background:#fff;color:var(--ink,#1f2933);font:inherit;font-size:13.5px;font-weight:600;line-height:1.2;text-decoration:none;white-space:nowrap;cursor:pointer;box-shadow:none;transition:background .16s,border-color .16s}
+.actions a:hover,.actions button:hover:not(:disabled){background:var(--g-100,#e4f3ec);border-color:#b6dac8}
+.actions button{color:#b42318;border-color:#f0cdc9}
+.actions button:hover:not(:disabled){background:#fdecea;border-color:#f1a9a0}
+.actions button:disabled{opacity:.55;cursor:not-allowed}
+.actions a:focus-visible,.actions button:focus-visible{outline:3px solid rgba(31,131,102,.35);outline-offset:2px}
+
+.empty{margin:0 0 16px;color:var(--ink-3,#667085);font-size:14px}
+
+.upload{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) auto;align-items:end;gap:12px 16px;padding:16px;border:1px dashed #b6d4c6;border-radius:12px;background:var(--g-50,#f8fafb)}
+.upload label{display:grid;gap:6px;min-width:0;font-size:13px;font-weight:600;color:var(--ink-2,#334155)}
+.upload input[type="text"]{width:100%;min-width:0;min-height:42px;padding:9px 12px;border:1px solid #d3dfd8;border-radius:11px;background:#fbfdfc;color:var(--ink,#1f2933);font:inherit;font-size:14px;font-weight:500;outline:none;transition:border-color .16s,box-shadow .16s}
+.upload input[type="text"]:focus{border-color:var(--g-600,#1f8366);box-shadow:0 0 0 3px rgba(31,131,102,.18)}
+.upload input[type="text"]:disabled{opacity:.6}
+.upload button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 20px;border:1px solid transparent;border-radius:11px;font:inherit;font-size:14px;font-weight:700;line-height:1.2;white-space:nowrap;cursor:pointer}
+.upload .primary{background:linear-gradient(135deg,var(--g-700,#176b54),var(--g-600,#1f8366));color:#fff;box-shadow:0 4px 12px rgba(23,107,84,.22)}
+.upload .primary:hover:not(:disabled){filter:brightness(1.05)}
+.upload button:disabled{opacity:.55;cursor:not-allowed;box-shadow:none}
+.upload button:focus-visible{outline:3px solid rgba(31,131,102,.35);outline-offset:2px}
+.hint{grid-column:1 / -1;margin:0;color:var(--ink-3,#667085);font-size:12.5px;line-height:1.55}
+
+.error,.success{margin:0 0 16px;padding:12px 16px;border-radius:12px;font-size:14px;font-weight:600;line-height:1.6}
 .error{background:#fdecea;border:1px solid #f1a9a0;color:#8a1c10}
 .success{background:#e8f6ee;border:1px solid #9bd3b0;color:#14532d}
+
+@media (max-width:720px){
+  .card{padding:18px 16px}
+  .item{flex-direction:column;align-items:stretch}
+  .actions{justify-content:flex-start}
+  .upload{grid-template-columns:minmax(0,1fr)}
+  .upload .primary{justify-self:stretch}
+}
-- 
