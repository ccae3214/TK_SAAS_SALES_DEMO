# NextAuth Configuration
NEXTAUTH_URL=https://localhost
NEXTAUTH_SECRET=replace_with_a_long_random_secret
APP_ORIGIN=https://localhost
ADMIN_EMAILS=
# Comma-separated Gmail/Google login emails granted HR system administrator access.
HR_ADMIN_EMAILS=

# Google OIDC (Get these from Google Cloud Console)
OIDC_CLIENT_ID=your_google_client_id
OIDC_CLIENT_SECRET=your_google_client_secret
OIDC_ISSUER=https://accounts.google.com

# LINE Login (LINE Developers Console > LINE Login channel)
# Callback URL: ${NEXTAUTH_URL}/api/auth/callback/line
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINE Messaging API channel credentials (use the same LINE Provider as LINE Login)
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# Comma-separated LINE User IDs with root HR administrator privileges.
# Only these users may create, read, update, or delete other system administrator accounts.
HR_ADMIN_LINE_USER_IDS=

# LINE 記帳機器人（accounting-bot）：另一個官方帳號的 Messaging API channel。
# 這和上面 HR 的 LINE_MESSAGING_* 是不同的 channel，不能共用。
# Webhook URL: https://<你的網域>/line/accounting/callback
ACCOUNTING_LINE_CHANNEL_SECRET=
ACCOUNTING_LINE_CHANNEL_ACCESS_TOKEN=
# 選填：每日帳單推播時間（HH:MM，台北時間）；1 = 沒有帳單時也推播
ACCOUNTING_REMINDER_TIME=08:00
ACCOUNTING_SEND_EMPTY_REMINDER=0
# 圖片記帳（傳發票／轉帳截圖／帳單照片自動辨識）：需要 Anthropic API 金鑰
# （console.anthropic.com，按用量計費，與 claude.ai 訂閱分開）。留空 = 停用這個功能。
ACCOUNTING_ANTHROPIC_API_KEY=
# 選填：辨識用的模型（想省錢可改 claude-haiku-5-5）
ACCOUNTING_ANTHROPIC_MODEL=claude-sonnet-5-5
# 選填：1 = 群組裡的圖片也辨識（預設關閉，因為群組常有大量不相關的照片，每張都會計費）
ACCOUNTING_IMAGE_IN_GROUPS=0
# 選填：每個聊天室每天最多辨識幾張，避免被洗圖造成費用暴增
ACCOUNTING_MAX_IMAGES_PER_DAY=30

# AES-256-GCM key for encrypted HR document uploads. Keep a backup; losing it prevents decryption.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
HR_DOCUMENT_ENCRYPTION_KEY=

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=saas_demo
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/saas_demo


# TLS / Let's Encrypt Certbot
# These are required for automatic HTTPS certificate management
LETSENCRYPT_EMAIL=your_email@example.com
LETSENCRYPT_DOMAIN=yourdomain.com

# For local development, use self-signed certs or localhost certs
# For production, update LETSENCRYPT_DOMAIN to your real domain

# Cloudflare DDNS updates the apex A record every five minutes by default.
# CLOUDFLARE_API_TOKEN must be a scoped token for this zone (DNS Edit + Zone Read).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=
CLOUDFLARE_SUBDOMAIN=
CLOUDFLARE_PROXIED=true
CLOUDFLARE_DDNS_CRON=*/5 * * * *
