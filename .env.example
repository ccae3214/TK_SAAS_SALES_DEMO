# NextAuth Configuration
NEXTAUTH_URL=https://localhost
NEXTAUTH_SECRET=replace_with_a_long_random_secret
APP_ORIGIN=https://localhost
ADMIN_EMAILS=admin@example.com

# Google OIDC (Get these from Google Cloud Console)
OIDC_CLIENT_ID=your_google_client_id
OIDC_CLIENT_SECRET=your_google_client_secret
OIDC_ISSUER=https://accounts.google.com

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=saas_demo
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/saas_demo

# TLS / Let's Encrypt Certbot
# These are required for automatic HTTPS certificate management
LETSENCRYPT_EMAIL=your_email@example.com
LETSENCRYPT_DOMAIN=yourdomain.com

# For local development, use self-signed certs or localhost certs
# For production, update LETSENCRYPT_DOMAIN to your real domain
